# 复制为 backend/.env。进程环境变量优先，生产凭据请由部署环境提供。
# prod 启用 HTTPS 来源及安全 Cookie 启动校验。本机 HTTP 开发保留 default。
SPRING_PROFILES_ACTIVE=default
# PostgreSQL 主机、端口、目标库名、登录账号、密码与 TLS 模式。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tuplatform
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_SSLMODE=require
# DB_URL 可覆盖以上连接地址，例如 jdbc:postgresql://db.example.org:5432/tuplatform?sslmode=verify-full
# DB_USERNAME 可覆盖 DB_USER。
# 服务监听地址与端口，默认仅供本机访问。
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# none 直接使用连接来源。经受控反向代理部署设 native，代理须覆盖客户端传来的转发头。
FORWARD_HEADERS_STRATEGY=none
# Tomcat 信任的代理连接 IP 正则。按实际代理地址收窄，默认仅 IPv4 回环。
TRUSTED_PROXY_REGEX=127[.]0[.]0[.]1
# 注册验证、重置密码邮件的站点来源。填写协议、主机和可选端口，无路径或结尾斜杠。
PUBLIC_BASE_URL=http://localhost:5173
# 业务通知链接使用的公开站点来源，也是默认允许的浏览器来源。
APP_BASE_URL=http://127.0.0.1:8180
# 额外允许携带凭据的浏览器来源，以逗号分隔。同源部署时留空，禁止通配符。
CORS_ALLOWED_ORIGINS=
# 仅合成演练设 true，为该进程的埋点添加可清理的批次标记。prod 拒绝开启。
ANALYTICS_TEST_MODE=false
# Cookie 的 Secure 标志。本地 HTTP 为 false，生产 HTTPS 为 true。
SECURE_COOKIES=false
# 头像持久化目录，可使用服务账号可写的绝对路径。
AVATAR_DIRECTORY=./data/avatars
# 认证证件私有目录，必须位于静态目录和源码目录之外，默认在服务账号主目录。
# VERIFICATION_DIRECTORY=
# 老师资料表单默认的院校名。
# PILOT_SCHOOL_NAME=深圳技术大学
# 邮件总开关。生产须配置 SMTP 并启用。
MAIL_ENABLED=false
# SMTP 服务器地址与端口。
SMTP_HOST=
SMTP_PORT=587
# SMTP 登录用户名、密码与是否要求认证。
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
# 隐式 TLS 与 STARTTLS 开关。587 使用 false/true，465 使用 true/false。
SMTP_SECURE=false
SMTP_STARTTLS=true
# 发件地址。MAIL_FROM 可覆盖 SMTP_FROM。
SMTP_FROM=noreply@YOUR_DOMAIN
# 老师和需求允许选择的服务类别代码，各自逗号分隔。留空代表该端没有开放类别。
TEACHER_CATEGORIES=
REQUEST_CATEGORIES=
