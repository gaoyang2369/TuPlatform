# Copy values into your process environment; Spring does not auto-load .env files.
# Use an isolated database: Flyway creates tables when the API starts.
DB_URL=jdbc:postgresql://YOUR_SERVER_IP:5432/linke?sslmode=verify-full
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
PUBLIC_BASE_URL=http://localhost:5173
# false only for local HTTP development. HTTPS deployment must use true.
SECURE_COOKIES=false
MAIL_ENABLED=false
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=noreply@YOUR_DOMAIN
# For isolated synthetic tests only; actual open categories require a business decision.
TEACHER_CATEGORIES=
