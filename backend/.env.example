# Copy to backend/.env. Run the backend from its directory (mvnw.ps1 does this).
# Process environment overrides this file. Never put real credentials in this example.
# Use an isolated database: Flyway creates tables when the API starts.
DB_HOST=YOUR_SERVER_IP
DB_PORT=5432
DB_NAME=tuplatform
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_SSLMODE=require
# Alternatively set DB_URL and DB_USERNAME to override the split fields above.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
PUBLIC_BASE_URL=http://localhost:5173
# false only for local HTTP development. HTTPS deployment must use true.
SECURE_COOKIES=false
MAIL_ENABLED=false
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_AUTH=true
SMTP_SECURE=false
SMTP_STARTTLS=true
# For port 465, use SMTP_SECURE=true and SMTP_STARTTLS=false.
SMTP_FROM=noreply@YOUR_DOMAIN
# For isolated synthetic tests only; actual open categories require a business decision.
TEACHER_CATEGORIES=
REQUEST_CATEGORIES=
