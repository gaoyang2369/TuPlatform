# Copy to backend/.env. Run the backend from its directory (mvnw.ps1 does this).
# Process environment overrides this file. Never put real credentials in this example.
# Use an isolated database: Flyway creates tables when the API starts.
DB_HOST=YOUR_SERVER_IP
DB_PORT=5432
DB_NAME=tuplatform
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_SSLMODE=require
# Alternatively set DB_URL and DB_USERNAME to override the split fields above.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Optional persistent avatar directory (relative to backend working directory or absolute).
# AVATAR_DIRECTORY=./data/avatars
# PILOT_SCHOOL_NAME=深圳技术大学
PUBLIC_BASE_URL=http://localhost:5173
# Business notification links. For a separate Vite dev server use its browser URL.
APP_BASE_URL=http://127.0.0.1:8180
# Optional private proof directory outside all source, web and static roots.
# Default: ~/.tuplatform/private_uploads/verifications under the backend service account.
# VERIFICATION_DIRECTORY=
# false only for local HTTP development. HTTPS deployment must use true.
SECURE_COOKIES=false
MAIL_ENABLED=false
# With mail disabled or SMTP settings absent, business notifications are logged as JSON.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_SECURE=false
SMTP_STARTTLS=true
# For port 465, use SMTP_SECURE=true and SMTP_STARTTLS=false.
SMTP_FROM=noreply@YOUR_DOMAIN
# MAIL_FROM overrides SMTP_FROM when set.
# For isolated synthetic tests only; actual open categories require a business decision.
TEACHER_CATEGORIES=
REQUEST_CATEGORIES=
